{
  "openapi": "3.0.3",
  "info": {
    "title": "Amaranta Sales-Catalog Contract",
    "version": "1.0.0",
    "description": "Network contract used by Sales. Sales never reads catalog_db directly."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "paths": {
    "/v1/stock/reservations": {
      "post": {
        "operationId": "reserveStock",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stock reserved and a price snapshot returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ReservedStockLine"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ClientError"
          },
          "404": {
            "$ref": "#/components/responses/ClientError"
          },
          "409": {
            "$ref": "#/components/responses/ClientError"
          }
        }
      }
    },
    "/v1/stock/releases": {
      "post": {
        "operationId": "releaseStock",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Stock released."
          },
          "400": {
            "$ref": "#/components/responses/ClientError"
          },
          "404": {
            "$ref": "#/components/responses/ClientError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CorrelationId": {
        "name": "x-correlation-id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,100}$"
        }
      }
    },
    "schemas": {
      "StockRequest": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity"
              ],
              "properties": {
                "productId": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "ReservedStockLine": {
        "type": "object",
        "required": [
          "productId",
          "productName",
          "unitPriceAmount",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "unitPriceAmount": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "ClientError": {
        "description": "Rejected request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
